
FeatureViewer {
    width: 100%;
    background: $surface;
    overflow-y: scroll;
    scrollbar-size-vertical: 2
}

FeatureViewer .featurevier--label {
    color: white 30%;
}

FeatureViewer .featurevier--default-feature {
    color: grey;
}
FeatureViewer .featurevier--type-cds {
    color: green;
}
FeatureViewer .featurevier--type-gene {
    color: blue;
}
FeatureViewer .featurevier--type-mrna {
    color: orange;
}
FeatureViewer .featurevier--type-rrna {
    color: cyan;
}
FeatureViewer .featurevier--type-trna {
    color: magenta;
}
FeatureViewer .featurevier--type-rep_origin {
    color: pink;
}
FeatureViewer .featurevier--type-regulatory {
    color: purple;
}
FeatureViewer .featurevier--type-sig_peptide {
    color: red;
}
FeatureViewer .featurevier--type-variation {
    color: yellow;
}

LocalViewport {
    height: 6fr;
}

.focus-highlight-border {
    border: round gray;
}

.focus-highlight-border:focus-within {
    border: round green;
}


PositionBar {
    height: 2;
    background: $panel;
    color: $accent;
    margin-right: 2;

    #left{
        text-align: left;
        width: 1fr;
    }
    #middle{
        text-align: center;
        width: 1fr;
    }
    #right{
        text-align: right;
        width: 1fr;
    }
}    

ZoomDetailsBar {
    height: 1;
    background: $panel;
    color: $accent;
    margin-right: 2;
    dock: bottom;

    #left{
        text-align: left;
        width: 1fr;
    }
    #middle{
        text-align: center;
        width: 1fr;
    }
    #right{
        text-align: right;
        width: 1fr;
    }
}    

QualifierViewer {
    padding: 1 1 1 1;
    scrollbar-size-vertical: 1;

}

#feature-details {
    dock: right;
    display: none;
    width: 30%;
    height: 100%;
    background: darkcyan;
    margin-left: 1;
    border-left: thick gray;
}

#feature-details:focus {
    # background-tint: white 20%;
    border-left: thick orange;
}

.visible-features-data-table {
    width: 1fr;
    height: 100%;
}

.visible-features-details {
    width: 1fr;
}

.focus-highlight-background:focus-within{
    background: $panel;
}

.text-search-placeholder {
    text-align: center;
    color: $error;
}

#search-container Input {
    border: none;
    border-bottom: inner $panel;
    height: 2;
    margin: 1 1 0 1;
    padding-left: 1;
}

#search-container Input:focus {
    border-bottom: inner $primary;
}

ModalScreen {
    align: center middle;
}

.large-modal-screen-container{
    width: 90%;
    height: 90%;
}

#goto-container{
    width: 80;
    height: 8;
}

#goto-message{
    margin: 1 3
}

.features-data-table {
    width: auto;
    max-width: 50%;
    margin-right: 1 ;
}

.features-details {
    width: 1fr;
    padding: 1;
}

#locus-switcher-container Label {
    padding: 1;
}